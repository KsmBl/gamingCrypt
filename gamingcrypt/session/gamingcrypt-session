#!/bin/sh
# GamingCrypt gaming session (installed by install.sh --session).
#
# gamescope runs GamingCrypt as the only thing on screen. "Desktop mode" in
# GamingCrypt writes $STATE/next-mode and closes it -> the desktop session
# (tileWin) starts; logging out of the desktop comes back to gaming mode - all
# within this one login. If gaming mode keeps failing to start, fall back to the
# desktop so nobody is stuck on a black screen.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/gamingcrypt"
# one-shot requests live in the runtime dir: a reboot never inherits them
if [ -n "$XDG_RUNTIME_DIR" ]; then RUN="$XDG_RUNTIME_DIR/gamingcrypt"; else RUN="$STATE/run"; fi
CONFDIR="${XDG_CONFIG_HOME:-$HOME/.config}/gamingcrypt"
LAUNCHER="${GC_LAUNCHER:-@LAUNCHER@}"
GAMESCOPE="${GC_GAMESCOPE:-gamescope}"
DESKTOP_EXEC="${GC_DESKTOP_EXEC:-@DESKTOP_EXEC@}"
GAMESCOPE_ARGS="${GC_GAMESCOPE_ARGS:--f --xwayland-count 2 --default-touch-mode 4 --hide-cursor-delay 3000}"
# own gamescope options (e.g. "-W 1280 -H 800 -r 60") replace the defaults
CONF="$CONFDIR/gamescope-args"
QUICK_EXIT_S="${GC_QUICK_EXIT_S:-15}"
MAX_QUICK_FAILS=3
KILL_GRACE_S="${GC_KILL_GRACE_S:-8}"

mkdir -p "$STATE" "$RUN"
rm -f "$STATE/next-mode"  # old location (before 0.5.2) - could be stale
log="$STATE/session.log"
fails=0

revert_display() {
	# new display options from Settings didn't work: back to the previous ones
	if [ -s "$CONFDIR/gamescope-args.previous" ]; then
		mv "$CONFDIR/gamescope-args.previous" "$CONF"
	else
		rm -f "$CONF" "$CONFDIR/gamescope-args.previous"
	fi
	rm -f "$CONFDIR/gamescope-args.pending"
	echo "$(date) new display mode failed - reverted" >>"$log"
}

while :; do
	mode=$(cat "$RUN/next-mode" 2>/dev/null)
	rm -f "$RUN/next-mode"
	if [ "$mode" = desktop ] || [ "$fails" -ge "$MAX_QUICK_FAILS" ]; then
		[ "$fails" -ge "$MAX_QUICK_FAILS" ] && echo "$(date) gaming mode failed $fails times - desktop" >>"$log"
		fails=0
		echo "$(date) desktop mode" >>"$log"
		sh -c "$DESKTOP_EXEC"
		continue  # desktop closed -> back to gaming mode
	fi
	args="$GAMESCOPE_ARGS"
	if [ -z "$GC_GAMESCOPE_ARGS" ] && [ -s "$CONF" ]; then
		args=$(cat "$CONF")  # own options (Settings, or e.g. "-W 1280 -H 800")
	fi
	# Steam mode (-e): gamescope follows GamingCrypt's window priority (GamingCrypt in
	# front, the game while playing, Steam's windows only when wanted). GamingCrypt sets
	# it through xprop - without xprop its window couldn't be shown in this mode.
	case " $args " in
	*" -e "* | *" --steam "*) ;;
	*) if command -v "${GC_XPROP:-xprop}" >/dev/null 2>&1; then args="-e $args"; fi ;;
	esac
	# performance overlay (quick menu): mangoapp reads $CONFDIR/mangohud.conf, hidden until switched on
	if command -v "${GC_MANGOAPP:-mangoapp}" >/dev/null 2>&1; then
		case " $args " in *" --mangoapp "*) ;; *) args="$args --mangoapp" ;; esac
		[ -f "$CONFDIR/mangohud.conf" ] || { mkdir -p "$CONFDIR"; echo no_display >"$CONFDIR/mangohud.conf"; }
		export MANGOHUD_CONFIGFILE="$CONFDIR/mangohud.conf"
	fi
	echo "$(date) gaming mode: gamescope $args" >>"$log"
	start=$(date +%s)
	# shellcheck disable=SC2086 - the args are meant to split
	GAMINGCRYPT_SESSION=1 QT_QPA_PLATFORM=xcb XDG_CURRENT_DESKTOP=gamescope \
		"$GAMESCOPE" $args -- "$LAUNCHER" >>"$log" 2>&1 &
	gs=$!
	# gamescope in Steam mode ignores SIGTERM: once GamingCrypt asked to leave (next-mode)
	# it gets a few seconds, then it's ended hard - otherwise the screen stays frozen
	# (GamingCrypt can't do that itself: it dies with gamescope's X server).
	(
		while [ ! -f "$RUN/next-mode" ]; do sleep 1; done
		sleep "$KILL_GRACE_S"
		echo "$(date) gamescope didn't exit - killing it" >>"$log"
		kill -KILL "$gs" 2>/dev/null
	) &
	watchdog=$!
	wait "$gs"
	code=$?
	kill "$watchdog" 2>/dev/null
	[ -f "$RUN/next-mode" ] && continue  # Desktop mode, or a restart for new display settings
	if [ "$code" -eq 0 ]; then
		exit 0  # closed on purpose -> end the session (log out / shutdown)
	fi
	if [ $(($(date +%s) - start)) -lt "$QUICK_EXIT_S" ] && [ -f "$CONFDIR/gamescope-args.pending" ]; then
		revert_display
		continue
	fi
	if [ $(($(date +%s) - start)) -lt "$QUICK_EXIT_S" ]; then
		fails=$((fails + 1))
	else
		fails=0
	fi
	echo "$(date) gaming mode exited with $code (quick failures: $fails)" >>"$log"
	sleep 1  # crashed -> start again
done
